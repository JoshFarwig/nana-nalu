# Local Development Environment Variables
# For running Alembic migrations from your HOST machine (not inside Docker)
# Copy this file to .env.local and fill in your values
#
# KEY DIFFERENCE FROM .env.dev:
# - DB__HOST=localhost (not 'db') since you're connecting from outside Docker
# - Ports should match your docker-compose exposed ports

# GENERAL CONFIGURATION
ENV=dev
REGIONS=maui
API__ADMIN_USERNAME=your_admin_username
API__ADMIN_PASSWORD=your_secure_password
API__ADMIN_EMAIL=admin@example.com
API__JWT_SECRET_KEY=your_jwt_private_key
API__APP_URL=your_ui_app_url_for_token_redirect

# DATABASE CONFIGURATION (for HOST machine access)
DB__HOST=localhost
DB__PORT=5432
DB__USERNAME=your_db_username
DB__PASSWORD=your_db_password
DB__NAME=your_db_name

# REDIS CONFIGURATION (for HOST machine access)
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=your_redis_password

# API KEYS
API__RESEND_API_KEY=your_resend_key
