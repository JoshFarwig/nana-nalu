# docker Compose Environment Variables
# copy this file to .env.dev and fill in your values
# usage: docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up

# GENERAL CONFIGURATION
ENV=dev
REGIONS=maui
API__ADMIN_USERNAME=your_admin_username
API__ADMIN_PASSWORD=your_secure_password

# DATABASE CONFIGURATION
DB__HOST=db
DB__PORT=5432
DB__USERNAME=your_db_username
DB__PASSWORD=your_db_password
DB__NAME=your_db_name
