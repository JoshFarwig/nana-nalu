# custom dockerfile for platform agnostic setup for pg18 + postgis 3
FROM postgres:18-bookworm

RUN apt-get update && \
  apt-cache search postgis | grep postgresql-18 && \
  apt-cache policy postgresql-18-postgis-3

RUN apt-get update && \
  apt-get install -y \
  postgresql-18-postgis-3 \
  postgresql-18-postgis-3-scripts \
  && rm -rf /var/lib/apt/lists/*
