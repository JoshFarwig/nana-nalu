FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim as base

WORKDIR /backend

# UV configuration
ENV UV_PYTHON_INSTALL_DIR=/usr/local/python \
  UV_COMPILE_BYTECODE=1 \
  UV_LINK_MODE=copy \
  UV_LOCKED=1 \
  UV_NO_DEV=1

# install base dependencies
RUN --mount=type=cache,target=/root/.cache/uv \
  --mount=type=bind,source=uv.lock,target=uv.lock \
  --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
  uv sync --no-install-project

# copy project and install
COPY . /backend
RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync

# ==============================================================================
# API service
# ==============================================================================
FROM base as api

RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --group api

# create non-root user and transfer ownership
RUN groupadd -r appuser && \
  useradd -r -g appuser appuser && \
  chown -R appuser:appuser /backend

ENV PATH="/backend/.venv/bin:$PATH" \
  PYTHONPATH=/backend

USER appuser
ENTRYPOINT []
CMD ["uvicorn", "api.v1.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ==============================================================================
# Worker service (with eccodes support)
# Built directly in worker stage rather than separate build stage to avoid
# cross-stage contamination of Python environment during COPY operations.
# The single RUN command keeps layers efficient while cleanup removes build tools.
# ==============================================================================
FROM base as worker

ARG TARGETARCH
ARG TARGETOS

COPY scripts/build_eccodes_arm64.sh /tmp/
RUN chmod +x /tmp/build_eccodes_arm64.sh && \
  TARGETOS=$TARGETOS TARGETARCH=$TARGETARCH /tmp/build_eccodes_arm64.sh && \
  rm /tmp/build_eccodes_arm64.sh

# set eccodes environment for findlibs to locate system library 
# must be in /usr/local or cMake install will corrupt uv's python 
# build
# See: https://github.com/ecmwf/findlibs
ENV ECCODES_DIR=/usr/local

# install worker group dependencies
# pyproject.toml override-dependencies excludes eccodeslib on ARM64 Linux
RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --group worker

# create non-root user and transfer ownership
RUN groupadd -r appuser && \
  useradd -r -g appuser appuser && \
  chown -R appuser:appuser /backend

ENV PATH="/backend/.venv/bin:$PATH" \
  PYTHONPATH=/backend

USER appuser
ENTRYPOINT []
CMD ["celery", "-A", "workers.worker_app", "worker", \
  "-Q", "forecasts,celery", \
  "--loglevel=info", \
  "--pool=prefork", \
  "--concurrency=2"]

# ==============================================================================
# Beat service
# ==============================================================================
FROM base as beat

RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --group beat

# create non-root user and transfer ownership
RUN groupadd -r appuser && \
  useradd -r -g appuser appuser && \
  chown -R appuser:appuser /backend

ENV PATH="/backend/.venv/bin:$PATH" \
  PYTHONPATH=/backend

USER appuser
ENTRYPOINT []
# TODO: consider if schedule file persistence is needed via a volume? probably not for 
# current use case, would need to give write perms for the volume
CMD ["celery", "-A", "workers.beat_app", "beat", "--loglevel=info", "--schedule=/tmp/celerybeat-schedule"]

# ==============================================================================
# Flower service
# ==============================================================================
FROM base as flower

RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --group flower

# create non-root user and transfer ownership
RUN groupadd -r appuser && \
  useradd -r -g appuser appuser && \
  chown -R appuser:appuser /backend

ENV PATH="/backend/.venv/bin:$PATH" \
  PYTHONPATH=/backend

USER appuser
ENTRYPOINT []
CMD ["celery", "-A", "workers.flower_app", "flower", "--port=5555"]
