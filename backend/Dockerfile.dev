FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS base

WORKDIR /backend

# UV configuration
ENV UV_PYTHON_INSTALL_DIR=/usr/local/python \
  UV_COMPILE_BYTECODE=1 \
  UV_LINK_MODE=copy \
  UV_LOCKED=1 \
  UV_NO_DEV=1

# install base dependencies
RUN --mount=type=cache,target=/root/.cache/uv \
  --mount=type=bind,source=uv.lock,target=uv.lock \
  --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
  uv sync --no-install-project

# copy project and install
COPY . /backend
RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync

# ==============================================================================
# API service
# ==============================================================================
FROM base AS api

RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --group api

# create non-root user and transfer ownership
RUN groupadd -r appuser && \
  useradd -r -g appuser -m appuser && \
  chown -R appuser:appuser /backend

ENV PATH="/backend/.venv/bin:$PATH" \
  PYTHONPATH=/backend

USER appuser
ENTRYPOINT []
CMD ["uvicorn", "api.v1.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ==============================================================================
# Prefect Worker service (with eccodes support)
# Built directly in this stage rather than separate build stage to avoid
# cross-stage contamination of Python environment during COPY operations.
# ==============================================================================
FROM base AS worker

ARG TARGETARCH
ARG TARGETOS

COPY scripts/build_eccodes_arm64.sh /tmp/
RUN chmod +x /tmp/build_eccodes_arm64.sh && \
  TARGETOS=$TARGETOS TARGETARCH=$TARGETARCH /tmp/build_eccodes_arm64.sh && \
  rm /tmp/build_eccodes_arm64.sh

# set eccodes environment for findlibs to locate system library
# must be in /usr/local or cMake install will corrupt uv's python
# build
# See: https://github.com/ecmwf/findlibs
ENV ECCODES_DIR=/usr/local

# install worker group dependencies
# pyproject.toml override-dependencies excludes eccodeslib on ARM64 Linux
RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --group worker

# create non-root user and transfer ownership
RUN groupadd -r appuser && \
  useradd -r -g appuser -m appuser && \
  chown -R appuser:appuser /backend

ENV PATH="/backend/.venv/bin:$PATH" \
  PYTHONPATH=/backend

# Copy and prepare entrypoint script
COPY scripts/prefect_worker_entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER appuser
ENTRYPOINT []
# Entrypoint: waits for server, creates work pool, deploys flows, starts worker
CMD ["/entrypoint.sh"]
